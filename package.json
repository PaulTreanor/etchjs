{
  "name": "etchjs",
  "version": "0.1.1",
  "description": "Fill DOM elements with generated backgrounds: stippling, cross-hatching, and more.",
  "author": "Paul Treanor",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./vanilla": {
      "types": "./dist/vanilla.d.ts",
      "default": "./dist/vanilla.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "stipple",
    "pattern",
    "background",
    "dither",
    "cross-hatch"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PaulTreanor/etchjs.git"
  },
  "homepage": "https://github.com/PaulTreanor/etchjs#readme",
  "bugs": {
    "url": "https://github.com/PaulTreanor/etchjs/issues"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
